# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies
.idea/

# Reference PDFs (large, not source)
*.pdf
*.mobi

# Manual test screenshots and rasterized reference pages (generated)
test/manual/out/
test/manual/reference/

# Diagnostic output from test/widgets/page_fits_screen_test.dart

# Claude Code personal settings (permissions allowlist)
.claude/settings.local.json

# Cross-book comparison tooling
tool/__pycache__/

# Test diagnostics. Kept out of the repo root: the root is where
# Grey looks, and OPENEVIDENCE.md lives there now.
build/fits/

# Generated audit output. Every one of these is rebuilt by the script named in
# its own header, and a committed snapshot goes stale silently: on 2026-08-30 a
# stale doses.tsv made the formulary parity guard report an entry as orphaned,
# and a stale hand-off list nearly sent superseded doses to a reviewer.
# The ADJUDICATIONS in tool/crossbook/*_adjudication.md and
# loop_chart_disposition.md are NOT generated and stay tracked: they are what
# stops a later pass re-deriving a question that was already settled.
tool/crossbook/*.tsv
tool/crossbook/*.txt
tool/crossbook/candidates.md
tool/crossbook/side_by_side.md
tool/crossbook/rules_side_by_side.md
tool/crossbook/threshold_side_by_side.md
tool/*_parity.tsv
tool/protocolbook_clipped_text.tsv
tool/protocolbook_flattened_figures.tsv
tool/who_imci_chart_pages.tsv

# Upload key. Never commit this or the keystore it points at.
android/key.properties
*.jks
*.keystore
